# ── Database (your own Postgres, outside Docker) ─────────────────────────────
# Create a database and user in your Postgres first, then fill in these values.
#
#   Example (psql as superuser):
#     CREATE USER notes_user WITH PASSWORD 'your_password';
#     CREATE DATABASE notes_db OWNER notes_user;
#
# Use host.docker.internal to reach Postgres running on this machine.
# On Linux, docker-compose.yml already adds the host-gateway alias for you.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=notes_db
DB_USER=notes_user
DB_PASSWORD=change_me_please

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ─────────────────────────────────────────────────────────────────────────────
# Database (your own Postgres) 
# ─────────────────────────────────────────────────────────────────────────────
# Create a database and user in your Postgres first, then fill in these values.
#
#   Example (psql as superuser):
#     CREATE USER notes_user WITH PASSWORD 'your_password';
#     CREATE DATABASE notes_db OWNER notes_user;
#
# If the app runs in Docker and Postgres runs on your computer (not in another
# container), use host.docker.internal instead of localhost:
#   DB_HOST=host.docker.internal
#
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notes_db
DB_USER=notes_user
DB_PASSWORD=change_me_please

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=4000

# Optional — startup mode (visible note types). Same values as README / npm scripts.
# Docker Compose defaults to ALL if you omit MODE (see docker-compose.yml). Override
# e.g. MODE=DEFAULT. For plain `npm start` without Docker, unset MODE uses local.json / UI.
# MODE=DEFAULT

# Instance manager: start/stop other note-type servers from Services UI (default: enabled).
# Set to 0 on machines where the UI must not spawn processes.
# INSTANCE_MANAGER=0

# ─────────────────────────────────────────────────────────────────────────────
# Database backend
# ─────────────────────────────────────────────────────────────────────────────
# Default is Postgres. SQLite support is being added incrementally for the
# single-user vault model.
DB_BACKEND=postgres

# ─────────────────────────────────────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────────────────────────────────────
# Create a database and user in your Postgres first, then fill in these values.
#
#   Example (psql as superuser):
#     CREATE USER notes_user WITH PASSWORD 'your_password';
#     CREATE DATABASE notes_db OWNER notes_user;
#
# If the app runs in Docker and Postgres runs on your computer (not in another
# container), use host.docker.internal instead of localhost:
#   DB_HOST=host.docker.internal
#
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notes_db
DB_USER=notes_user
DB_PASSWORD=change_me_please

# ─────────────────────────────────────────────────────────────────────────────
# SQLite (experimental)
# ─────────────────────────────────────────────────────────────────────────────
# With DB_BACKEND=sqlite, the SQLite DB path comes from config/local.json.
# Prefer sqlite.path for a local, non-synced live DB while vaultPath can still
# point to a Dropbox-backed vault for attachments, palettes, and settings:
#   {
#     "vaultPath": "/home/you/MainNoteArchiveVault",
#     "sqlite": {
#       "enabled": true,
#       "path": "/home/you/NoteArchiveData/archive.sqlite"
#     }
#   }
# If sqlite.path is unset, SQLite uses <vaultPath>/archive.sqlite. The explicit
# sqlite.enabled guard prevents accidentally creating archive.sqlite in an
# existing Postgres vault. If both sqlite.path and vaultPath are unset, SQLite
# falls back to ./data/archive.sqlite. Restart after changing SQLite storage
# paths in Options/config.

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=4000

# Optional — startup mode (visible note types). Same values as README / npm scripts.
# Docker Compose defaults to ALL if you omit MODE (see docker-compose.yml). Override
# e.g. MODE=DEFAULT. For plain `npm start` without Docker, unset MODE uses local.json / UI.
# MODE=DEFAULT

# Instance manager: start/stop other note-type servers from Services UI (default: enabled).
# Set to 0 on machines where the UI must not spawn processes.
# INSTANCE_MANAGER=0

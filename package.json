{
  "name": "quotes-db",
  "version": "1.0.0",
  "description": "Quote collection and management system",
  "main": "src/server.js",
  "scripts": {
    "start": "npm run migrate && PORT=4000 node src/server.js",
    "dev": "npm run migrate && PORT=4000 nodemon src/server.js",
    "migrate": "node migrations/run-migrations.js",
    "split-backup": "node scripts/split-json-backup.js",
    "default": "node scripts/run-mode.js DEFAULT 4000",
    "all": "node scripts/run-mode.js ALL 4000",
    "quotes": "node scripts/run-mode.js QUOTES 4005",
    "notes": "node scripts/run-mode.js NOTES 4006",
    "historical": "node scripts/run-mode.js HISTORICAL 4007",
    "brain": "node scripts/run-mode.js BRAIN 4004",
    "training": "node scripts/run-mode.js TRAINING 4002",
    "job": "node scripts/run-mode.js JOB 4003",
    "tegneserie": "node scripts/run-mode.js TEGNESERIE 4001"
  },
  "keywords": [
    "quotes",
    "database",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.11.3",
    "puppeteer": "^24.37.5",
    "sharp": "^0.34.5",
    "stream-chain": "^3.6.3",
    "stream-json": "^2.1.0"
  },
  "devDependencies": {
    "canvas": "^3.2.1",
    "nodemon": "^3.0.1"
  }
}

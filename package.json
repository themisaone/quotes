{
  "name": "quotes-db",
  "version": "1.0.0",
  "description": "Quote collection and management system",
  "main": "src/server.js",
  "scripts": {
    "start": "npm run migrate && PORT=4000 node src/server.js",
    "dev": "npm run migrate && PORT=4000 nodemon src/server.js",
    "migrate": "node migrations/run-migrations.js",
    "split-backup": "node scripts/split-json-backup.js",
    "default": "node scripts/run-mode.js DEFAULT",
    "all": "node scripts/run-mode.js ALL",
    "quotes": "node scripts/run-mode.js QUOTES",
    "notes": "node scripts/run-mode.js NOTES",
    "historical": "node scripts/run-mode.js HISTORICAL",
    "brain": "node scripts/run-mode.js BRAIN",
    "training": "node scripts/run-mode.js TRAINING",
    "job": "node scripts/run-mode.js JOB",
    "tegneserie": "node scripts/run-mode.js TEGNESERIE"
  },
  "keywords": [
    "quotes",
    "database",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.11.3",
    "puppeteer": "^24.37.5",
    "sharp": "^0.34.5",
    "stream-chain": "^3.6.3",
    "stream-json": "^2.1.0"
  },
  "devDependencies": {
    "canvas": "^3.2.1",
    "nodemon": "^3.0.1"
  }
}
